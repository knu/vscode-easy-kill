{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommitsDisabled",
  ],
  labels: ["dependencies"],
  timezone: "Asia/Tokyo",
  schedule: ["after 9am on friday", "before 6pm on friday"],
  npm: {
    minimumReleaseAge: "3 days",
  },
  // Lockfiles are maintained by lockfile-maintenance-action.
  lockFileMaintenance: {
    enabled: false,
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["dependencies", "security"],
  },
  packageRules: [
    {
      matchUpdateTypes: ["major"],
      addLabels: ["dependencies:major"],
    },
    {
      // Keep runtime requirements and types compatible with older extension
      // hosts.  The development Node.js version is managed separately.
      description: "Keep the Node.js runtime floor and types on v20",
      matchManagers: ["npm"],
      matchDepNames: ["node", "@types/node"],
      allowedVersions: "<21",
    },
    {
      // Keep API types aligned with the minimum supported VS Code version.
      description: "Keep VS Code API types on the 1.95 compatibility floor",
      matchManagers: ["npm"],
      matchDepNames: ["@types/vscode"],
      allowedVersions: "~1.95.0",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      labels: ["dependencies"],
      minimumReleaseAge: "7 days",
    },
    {
      matchDepTypes: ["devDependencies"],
      groupName: "development dependencies",
      labels: ["dependencies", "automerge"],
      automerge: true,
      minimumReleaseAge: "3 days",
    },
  ],
}
